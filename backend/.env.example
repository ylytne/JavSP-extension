# =================================================================
# JavSP Backend 环境变量配置模板
# =================================================================
# 使用说明：
# 1. 本文件仅用于配置 Docker 宿主机层面的基础设施（路径映射与端口）
# 2. 所有应用层配置（包括 API 安全 Token、爬虫设置、翻译器等）均由挂载目录中的 config.yml 统一管理
# 3. 首次启动时，容器会在指定的配置目录下自动生成初始 config.yml 和 API_TOKEN.txt
# 4. 将本文件复制为 .env 文件即可生效：
#    cp .env.example .env
# =================================================================

# 宿主机配置持久化目录（映射至容器内部的 /app/config）：
# 例如群晖 Synology: /volume1/docker/javsp/config
# 例如 Unraid:        /mnt/user/appdata/javsp/config
# 例如 本地相对路径:  ./config
JAVSP_CONFIG_DIR=./config

# 宿主机影视媒体待整理与归档目录（映射至容器内部的 /media）：
# 例如群晖 Synology: /volume1/video
# 例如 Unraid:        /mnt/user/downloads
# 例如 Windows 本地:  D:/Videos 或 ./data
JAVSP_MEDIA_DIR=./data

# 服务对外映射端口（容器内部端口固定为 8765）
JAVSP_PORT=8765

# 容器运行时区
TZ=Asia/Shanghai
